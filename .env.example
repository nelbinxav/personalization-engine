# Copy to .env and fill in. `docker compose up` reads this file.

# ---------------------------------------------------------------------------
# REQUIRED. Encrypts provider keys at rest and signs session cookies.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every stored provider key unreadable (they can be re-entered).
# ---------------------------------------------------------------------------
APP_SECRET_KEY=

# ---------------------------------------------------------------------------
# DO NOT SET ANTHROPIC_API_KEY HERE IF YOU ARE USING OAUTH.
#
# The SDK's credential chain puts the env var ahead of the OAuth profile, so a
# key set here silently wins and bills whatever org it belongs to. Even an
# empty value wins its slot. The worker refuses to start in that state rather
# than doing the wrong thing quietly.
#
# To use an API key instead, leave this unset and enter the key in Settings --
# it is stored encrypted and both containers pick it up without a restart.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# Only for stages set to an OpenAI model (per-stage models in Settings). The
# key saved in Settings wins; this is a bootstrap fallback.
# OPENAI_API_KEY=

# Where the OAuth profile is persisted inside the containers. Matches the
# docker volume in docker-compose.yml; only change both together.
ANTHROPIC_CONFIG_DIR=/var/lib/anthropic
ANTHROPIC_OAUTH_PROFILE=app

# ---------------------------------------------------------------------------
# Scraping providers. All optional at boot -- enter them in Settings instead if
# you prefer. A source without its key reports that clearly on the row.
# ---------------------------------------------------------------------------
# Jina Reader (website text). Works without a key at a lower rate limit.
JINA_API_KEY=
# Serper.dev (Google News).
SERPER_API_KEY=
# Apify (LinkedIn profile + company).
APIFY_TOKEN=

# Google Sheets service account, as one line of JSON. Share the sheet with the
# service account's email. Public "anyone with the link" sheets need nothing.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:3000"]
# Set true when serving over HTTPS.
COOKIE_SECURE=false
# Where the BROWSER calls the API. "/" = the frontend's own address: the Next
# server forwards /api/v1/* to the api container, so the whole app is one
# address (one tunnel, no CORS). Use a full URL only to call a separate API
# host directly. Baked in at build time: after changing it, run
# `docker compose up -d --build frontend`.
NEXT_PUBLIC_API_URL=/
# Host interface the api/frontend ports are published on. Keep 127.0.0.1 on a
# server: Docker-published ports bypass the host firewall. Tailscale serve (or
# a Cloudflare tunnel) reaches them from the host itself.
BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# On a server behind HTTPS (see deploy/TAILSCALE.md), set COOKIE_SECURE=true.
# ALLOWED_ORIGINS only matters when NEXT_PUBLIC_API_URL points at another host.
# ---------------------------------------------------------------------------
